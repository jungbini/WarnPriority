{
  "name": "warnpriority",
  "displayName": "WarnPriority",
  "description": "%extension.description%",
  "version": "0.14.0",
  "publisher": "jungbini",
  "repository": {
    "type": "git",
    "url": "https://github.com/jungbini/WarnPriority"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "github",
    "commit",
    "diff",
    "mining software repositories"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "warnPriority.collectCommitChanges",
        "title": "%command.collectCommitChanges.title%",
        "category": "WarnPriority"
      },
      {
        "command": "warnPriority.clearRepositoryCache",
        "title": "%command.clearRepositoryCache.title%",
        "category": "WarnPriority"
      },
      {
        "command": "warnPriority.runPmd",
        "title": "%command.runPmd.title%",
        "category": "WarnPriority"
      },
      {
        "command": "warnPriority.topicModel",
        "title": "%command.topicModel.title%",
        "category": "WarnPriority"
      }
    ],
    "configuration": {
      "title": "WarnPriority",
      "properties": {
        "warnPriority.outputDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.outputDirectory%"
        },
        "warnPriority.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "java",
            "kt",
            "kts",
            "scala",
            "groovy",
            "c",
            "h",
            "cc",
            "cpp",
            "cxx",
            "hh",
            "hpp",
            "hxx",
            "cs",
            "go",
            "rs",
            "py",
            "js",
            "jsx",
            "mjs",
            "cjs",
            "ts",
            "tsx",
            "php",
            "rb",
            "swift",
            "m",
            "mm"
          ],
          "markdownDescription": "%config.fileExtensions%"
        },
        "warnPriority.maxCommits": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.maxCommits%"
        },
        "warnPriority.caseSensitive": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.caseSensitive%"
        },
        "warnPriority.useRegex": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.useRegex%"
        },
        "warnPriority.includeMergeCommits": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.includeMergeCommits%"
        },
        "warnPriority.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.ignoreWhitespace%"
        },
        "warnPriority.gitPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.gitPath%"
        },
        "warnPriority.pmd.ruleset": {
          "type": "string",
          "default": "all",
          "markdownDescription": "%config.pmd.ruleset%"
        },
        "warnPriority.pmd.home": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.pmd.home%"
        },
        "warnPriority.pmd.java": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.pmd.java%"
        },
        "warnPriority.topics.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.topics.pythonPath%"
        },
        "warnPriority.topics.model": {
          "type": "string",
          "default": "nomic-ai/CodeRankEmbed",
          "markdownDescription": "%config.topics.model%"
        },
        "warnPriority.topics.minTopicSize": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.topics.minTopicSize%"
        },
        "warnPriority.topics.extraStopwords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.topics.extraStopwords%"
        },
        "warnPriority.topics.excludeTestFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.topics.excludeTestFiles%"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "warnPriority.runPmd",
          "when": "resourceExtname == .json",
          "group": "9_warnPriority"
        },
        {
          "command": "warnPriority.topicModel",
          "when": "resourceExtname == .json",
          "group": "9_warnPriority"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node scripts/run-tests.js",
    "collect": "node ./out/cli.js",
    "package": "npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "~18.19.130",
    "@types/vscode": "~1.82.0",
    "typescript": "~5.9.3"
  }
}
